+ assert.ok(url.includes('liquidity_tolerance_bps=300'));assert.ok(url.includes('streaming_quantity=0'))
+ assert.equal((await api.POST(request({sellAsset:'BTC.BTC',buyAsset:'ETH.ETH',sellAmount:'1',slippage:100}))).status,400)
