+ const result=await route('tokens',async()=>Response.json([{asset:'ETH.USDC-0x123',status:'Available',decimals:6},{asset:'ETH.UNVERIFIED-0x456',status:'Available'}])).GET({nextUrl:new URL('https://local/')})
