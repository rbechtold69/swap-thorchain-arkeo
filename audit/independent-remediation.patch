+ const req=request({hash:'a'.repeat(64)})
+ assert.equal((await route('track',down).POST(req)).status,503)
+ const unknown=await route('track',async()=>Response.json({actions:[]})).POST(req)
+ assert.equal(unknown.status,200);assert.equal(unknown.body.status,'unknown')
+ assert.equal((await route('track',down).POST(request({hash:'abc&txid=injected'}))).status,400)
+})
+test('gas excludes halted chains and rejects malformed rates',async()=>{
+ const good=await route('gas',async()=>Response.json([{chain:'BTC',gas_rate:'4',gas_rate_units:'satsperbyte',halted:true}])).GET()
+ assert.equal(good.status,200);assert.equal(good.body.length,0)
+ assert.equal((await route('gas',async()=>Response.json([{chain:'BTC'}])).GET()).status,503)
+})
+test('quote preserves destinations and uses a single streaming memo with a real minimum',async()=>{
+ let url=''
