+
+function route(name:string, send:typeof fetch) {
+  const exports: any = {}
+  // Compile the actual Next handler while replacing only HTTP framework and transport.
+  const code=ts.transpileModule(fs.readFileSync(new URL(`../src/app/api/v1/${name}/route.ts`,import.meta.url),'utf8'),
+    {compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText
+  vm.runInNewContext(code,{exports, URLSearchParams, Date, BigInt, Number, process, fetch:send,
+    require:(name:string) => name==='next/server' ? {NextResponse:{json:(body:any,options:any={})=>({body,status:options.status||200})}} : {
+      ...transport,
+      fetchReadJson:(path:string,endpoints:string[],valid:any,_send?:typeof fetch,body?:object) => transport.fetchReadJson(path,endpoints,valid,send,body),
+      fetchThorQuote:(params:URLSearchParams) => transport.fetchThorQuote(params,['https://fixture.example'],send),
+    }})
+  return exports
+}
