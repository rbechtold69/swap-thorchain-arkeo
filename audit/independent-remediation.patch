+
+/** Bound decoded bytes as well as transfer time; never use for transaction submission. */
+export async function boundedJson(response: Response, maxBytes = 2 * 1024 * 1024): Promise<any> {
+  if (!response.body) throw new QuoteUnavailableError('Empty upstream response')
+  const reader = response.body.getReader()
+  const chunks: Uint8Array[] = []
+  let size = 0
+  try {
+    while (true) {
+      const { done, value } = await reader.read()
+      if (done) break
+      size += value.byteLength
+      if (size > maxBytes) throw new QuoteUnavailableError('Upstream response exceeds limit')
+      chunks.push(value)
+    }
+  } finally {
+    await reader.cancel().catch(() => {})
+    reader.releaseLock()
+  }
+  const bytes = new Uint8Array(size)
+  let offset = 0
+  for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.length }
+  return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes))
+}
+
+export function midgardEndpoints() {
+  return quoteEndpoints(process.env.MIDGARD_URLS || 'https://gateway.liquify.com/chain/thorchain_midgard,https://midgard.thorchain.network')
+}
+
+export async function fetchReadJson<T>(path: string, endpoints: string[], valid: (data: any) => data is T,
+                                      send: typeof fetch = fetch, rpcBody?: object): Promise<T> {
+  if (!path.startsWith('/') || path.startsWith('//')) throw new QuoteInputError('Invalid API path')
+  for (const endpoint of endpoints.slice(0, 3)) {
+    try {
+      const response = await send(endpoint + path, {
+        method: rpcBody ? 'POST' : 'GET', cache: 'no-store', redirect: 'error', signal: AbortSignal.timeout(2500),
+        ...(rpcBody ? { headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(rpcBody) } : {}),
+      })
+      if (!response.ok) { await response.body?.cancel(); continue }
+      const data = await boundedJson(response)
+      if (valid(data)) return data
+    } catch { /* Read-only failover. No credentials or response bodies in errors. */ }
+  }
+  throw new QuoteUnavailableError('Upstream data unavailable')
+}
+
+export function minimumOutput(amount: string, slippageBps: number): string {
+  if (!Number.isInteger(slippageBps) || slippageBps < 0 || slippageBps >= 10000 || !/^\d+$/.test(amount)) {
+    throw new QuoteInputError('Invalid slippage or amount')
+  }
+  return fromThorBaseUnits((BigInt(amount) * BigInt(10000 - slippageBps) / 10000n).toString())
+}
